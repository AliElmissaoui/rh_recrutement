<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_recruitment_planning_return_wizard_form"
            model="ir.ui.view">

        <field name="name">recruitment.planning.return.wizard.form</field>
        <field name="model">recruitment.planning.return.wizard</field>
           
        

        <field name="arch" type="xml">

            <form string="Retour de la planification">

                <sheet>

                    <group>

                        <field name="planning_id"/>

                        <field name="current_state"/>

                        <field name="reason"
                               placeholder="Veuillez indiquer le motif du retour..."
                               required="1"/>

                    </group>

                </sheet>

                <footer>

                    <button name="action_confirm_return"
                            string="Confirmer le retour"
                            type="object"
                            class="btn-primary"/>

                    <button string="Annuler"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>

</odoo>