<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- ===================================================== -->
    <!-- DIRECTION TREE -->
    <!-- ===================================================== -->

    <record id="view_recruitment_direction_list"
            model="ir.ui.view">

        <field name="name">recruitment.direction.list</field>
        <field name="model">recruitment.direction</field>
        <field name="arch" type="xml">
            <list string="Directions">
                <field name="name"/>
                <field name="director_id"/>
                <field name="active"/>

            </list>

        </field>

    </record>


    <!-- ===================================================== -->
    <!-- DIRECTION FORM -->
    <!-- ===================================================== -->

    <record id="view_recruitment_direction_form"
            model="ir.ui.view">

        <field name="name">
            recruitment.direction.form
        </field>

        <field name="model">recruitment.direction</field>

        <field name="arch" type="xml">

            <form string="Direction">

                <sheet>

                    <group>

                        <field name="name"/>

                        <field name="director_id"/>

                        <field name="active"/>

                    </group>

                    <notebook>

                        <page string="Projets">

                            <field name="project_ids">

                                <list>

                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="active"/>

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>

    </record>


    <!-- ===================================================== -->
    <!-- ACTION -->
    <!-- ===================================================== -->

    <record id="action_recruitment_direction"
            model="ir.actions.act_window">

        <field name="name">Directions</field>
        <field name="res_model">recruitment.direction</field>
        <field name="view_mode">list,form</field>
        <field name="groups_id"
               eval="[(4, ref('gestion_recrutement.group_recruitment_chef_service'))]"/>

    </record>


    <!-- ===================================================== -->
    <!-- MENU -->
    <!-- ===================================================== -->



</odoo>